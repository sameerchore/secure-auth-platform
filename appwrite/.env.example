# Appwrite Environment Variables
# Copy to .env and fill in your Appwrite project details.

# Appwrite server endpoint
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Project ID (from Appwrite Console → Settings)
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID

# Server-side API Key (for setup/seed scripts ONLY — never expose to client)
APPWRITE_API_KEY=YOUR_API_KEY

# Database ID (create in Appwrite Console → Databases)
APPWRITE_DATABASE_ID=secure_auth_db

# Collection ID for file metadata documents
APPWRITE_FILES_COLLECTION_ID=files

# Storage bucket ID for actual file storage
APPWRITE_BUCKET_ID=user-files
