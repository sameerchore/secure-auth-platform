# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_auth_db

# Server
PORT=3000
NODE_ENV=development

# Session / Cookie
COOKIE_SECRET=change-me-to-a-random-64-char-string
COOKIE_NAME=sid
SESSION_EXPIRY_MS=86400000

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MS=300000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001
